# FACULTATIF : les réglages sont déjà écrits dans sentinelle/settings.py (bloc « RÉGLAGES »).
# Un fichier « .env » (copie de celui-ci, jamais envoyé sur git) sert seulement à en remplacer un.

# Base de données : par défaut sentinelle.db à côté de manage.py (exclu de git).
# SENTINELLE_BD=/chemin/vers/sentinelle.db

# Clé secrète Django. Générez-en une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (si absente, une clé est créée automatiquement dans le fichier .cle_secrete)
DJANGO_SECRET_KEY=

# Adresse(s) du frontend autorisée(s) à appeler l'API (séparées par des virgules).
SENTINELLE_ORIGINES=https://votre-site.vercel.app

# Site en HTTPS (PythonAnywhere, VPS avec Caddy) : cookies sécurisés.
SENTINELLE_HTTPS=1

# Noms de domaine acceptés (séparés par des virgules). * = tous.
# SENTINELLE_HOTES=votre-nom.pythonanywhere.com

# Notifications push : générez les clés avec  python generer_cles_push.py
SENTINELLE_VAPID_PUBLIC_KEY=
SENTINELLE_VAPID_PRIVATE_KEY=
SENTINELLE_VAPID_SUBJECT=mailto:vous@exemple.com

# --- VPS uniquement ---------------------------------------------------------
# WebSockets (Django Channels, serveur uvicorn) :
# SENTINELLE_WEBSOCKET=1
# Plusieurs processus uvicorn : Redis obligatoire
# SENTINELLE_REDIS_URL=redis://localhost:6379/0
